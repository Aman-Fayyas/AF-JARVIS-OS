#!/bin/sh
set -eu
lb config noauto \
    --mode debian \
    --distribution trixie \
    --architecture amd64 \
    --linux-flavours amd64 \
    --binary-image iso-hybrid \
    --bootloaders 'syslinux grub-efi' \
    --archive-areas 'main non-free-firmware' \
    --apt-recommends false \
    --apt-secure true \
    --security true \
    --updates true \
    --firmware-chroot true \
    --firmware-binary true \
    --debian-installer live \
    --debian-installer-gui false \
    --image-name live-image \
    --iso-application 'AF JARVIS OS v0.1 Alpha' \
    --iso-volume AF_JARVIS_01 \
    --bootappend-live 'boot=live components username=jarvis hostname=af-jarvis live-config.noautologin live-config.nocomponents=sudo,policykit' \
    "$@"
